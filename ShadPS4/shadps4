#!/usr/bin/env bash

SCRIPT_DIR=$(dirname $(realpath $0))

BIN_DIR="${SCRIPT_DIR}/bin"
EXECUTABLE_PATH="${BIN_DIR}/Shadps4-sdl.AppImage"
EXECUTE_ARGS=()
DOWNLOAD_FILENAME_PATTERN="^shadps4-linux-.*.zip$"
REPO="shadps4-emu/shadPS4"
process_download() { unzip -d ${BIN_DIR} ${1}; }
get_latest_release() { echo $(curl -s "https://api.github.com/repos/${REPO}/releases/latest" | jq -r '.assets[] | select(.name | test('\"${DOWNLOAD_FILENAME_PATTERN}\"'))'); }
after_download() { exit 0; }

if [ "$#" -eq 0 ]; then
    ${EXECUTABLE_PATH}
    exit ${?}
fi

if [[ "$1" == "run" ]]; then
    # Steam container workarounds
    export PATH="/run/host/usr/bin/:${PATH}"
    export LD_LIBRARY_PATH="/run/host/usr/lib64:${LD_LIBRARY_PATH}"
    curl() { command curl --cacert "/etc/ssl/certs/ca-certificates.crt" ${@}; }

    latest_release=`get_latest_release`
    latest_release_id=`echo ${latest_release} | jq -r .id`
    if [ "${latest_release}" != "" ]; then
        release_id_path=${BIN_DIR}/release_id
        if [ -f "${release_id_path}" ]; then
            current_release_id=$(cat ${release_id_path})
        else
            current_release_id=""
        fi
        if [[ ${latest_release_id} != ${current_release_id} ]] || [[ ! -f ${EXECUTABLE_PATH} ]]; then
            file_download_path="/tmp/download.temp"
            download_url=$(echo ${latest_release} | jq -r '.browser_download_url')
            curl -L -o ${file_download_path} ${download_url}
            mkdir -p ${BIN_DIR}
            rm -rf ${BIN_DIR}/*
            process_download ${file_download_path} > /dev/null
            chmod +x ${EXECUTABLE_PATH}
            echo ${latest_release_id} > ${release_id_path}
            rm -rf ${file_download_path}
        fi
    fi
    after_download
fi

${EXECUTABLE_PATH} "${EXECUTE_ARGS[@]}" "${@:2}"
